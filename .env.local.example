# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit it.
#
# Only NEXT_PUBLIC_* variables belong here. Anything private (API secrets,
# database credentials) must live on the backend only — see BACKEND_RULES.md §30.

# Base URL of the Rails API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Razorpay publishable key ID — NOT used as a separate frontend env var.
# The backend returns it inline on POST /orders (order.razorpay.key_id,
# sourced server-side from RAZORPAY_KEY_ID) so there's one source of truth
# instead of two copies of the same id to keep in sync — see Phase 2's entry
# in docs/PROGRESS.md. Left here only as a documented non-use, not a TODO.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

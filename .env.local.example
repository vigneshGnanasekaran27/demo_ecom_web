# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit it.
#
# Only NEXT_PUBLIC_* variables belong here. Anything private (API secrets,
# database credentials) must live on the backend only — see BACKEND_RULES.md §30.

# Base URL of the Rails API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Razorpay publishable key ID (safe to expose client-side). Used by Razorpay
# Checkout in Phase 10 — leave blank until then.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
